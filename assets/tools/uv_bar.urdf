<?xml version="1.0"?>
<!-- The UV bar as built (FULLUVBAR_forWenyi.stp, the fab team, 2026-10-01; assets/tools/cad/), mounted on the
     FR20's flange. Root link: the flange's mounting face (z out of the face). From the CAD (mm; its z = 0 the
     bar's middle, the plate under it): the mounting plate (about 116 dia, 12 thick, 17 at its rim) on the face; the bar (an
     extrusion 1087.5 long with its end caps) over it, its middle 29.75 out: 37 wide over its middle 18, about
     30 wide above and below that; the 3D-printed shade on top, its rim 47.35 out (led_tcp: the scan's gap is
     measured from it; the LED chips sit 4.6 below it). The checks make each box a capsule round its longest
     side (collision.tool_capsules), so the parts are split where one box's capsule would bulge far past them:
     the plate into four strips, the bar into its middle and two strips above and two below, the block
     between plate and bar (about 66 x 100 x 16, under the bar's middle) into two. The bar's length
     along the flange's y. "strip" (the bar's middle) is the strip: listed first of the long boxes. -->
<robot name="uv_bar">
  <link name="tool_mount"/>
  <link name="strip">
    <collision><origin xyz="0 0 0.02975" rpy="0 0 0"/><geometry><box size="0.037 1.0875 0.018"/></geometry></collision>
  </link>
  <joint name="tool_mount_to_strip" type="fixed"><parent link="tool_mount"/><child link="strip"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
  <link name="strip_top_a">
    <collision><origin xyz="-0.00725 0 0.0430" rpy="0 0 0"/><geometry><box size="0.0145 1.0875 0.0094"/></geometry></collision>
  </link>
  <joint name="tool_mount_to_strip_top_a" type="fixed"><parent link="tool_mount"/><child link="strip_top_a"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
  <link name="strip_top_b">
    <collision><origin xyz="0.00725 0 0.0430" rpy="0 0 0"/><geometry><box size="0.0145 1.0875 0.0094"/></geometry></collision>
  </link>
  <joint name="tool_mount_to_strip_top_b" type="fixed"><parent link="tool_mount"/><child link="strip_top_b"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
  <link name="strip_bottom_a">
    <collision><origin xyz="-0.0075 0 0.01645" rpy="0 0 0"/><geometry><box size="0.015 1.0875 0.0087"/></geometry></collision>
  </link>
  <joint name="tool_mount_to_strip_bottom_a" type="fixed"><parent link="tool_mount"/><child link="strip_bottom_a"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
  <link name="strip_bottom_b">
    <collision><origin xyz="0.0075 0 0.01645" rpy="0 0 0"/><geometry><box size="0.015 1.0875 0.0087"/></geometry></collision>
  </link>
  <joint name="tool_mount_to_strip_bottom_b" type="fixed"><parent link="tool_mount"/><child link="strip_bottom_b"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
  <link name="bracket_a">
    <collision><origin xyz="-0.0435 0 0.009" rpy="0 0 0"/><geometry><box size="0.029 0.119 0.018"/></geometry></collision>
  </link>
  <joint name="tool_mount_to_bracket_a" type="fixed"><parent link="tool_mount"/><child link="bracket_a"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
  <link name="bracket_b">
    <collision><origin xyz="-0.0145 0 0.009" rpy="0 0 0"/><geometry><box size="0.029 0.119 0.018"/></geometry></collision>
  </link>
  <joint name="tool_mount_to_bracket_b" type="fixed"><parent link="tool_mount"/><child link="bracket_b"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
  <link name="bracket_c">
    <collision><origin xyz="0.0145 0 0.009" rpy="0 0 0"/><geometry><box size="0.029 0.119 0.018"/></geometry></collision>
  </link>
  <joint name="tool_mount_to_bracket_c" type="fixed"><parent link="tool_mount"/><child link="bracket_c"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
  <link name="bracket_d">
    <collision><origin xyz="0.0435 0 0.009" rpy="0 0 0"/><geometry><box size="0.029 0.119 0.018"/></geometry></collision>
  </link>
  <joint name="tool_mount_to_bracket_d" type="fixed"><parent link="tool_mount"/><child link="bracket_d"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
  <link name="mount_a">
    <collision><origin xyz="-0.0165 0 0.020" rpy="0 0 0"/><geometry><box size="0.033 0.10 0.016"/></geometry></collision>
  </link>
  <joint name="tool_mount_to_mount_a" type="fixed"><parent link="tool_mount"/><child link="mount_a"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
  <link name="mount_b">
    <collision><origin xyz="0.0165 0 0.020" rpy="0 0 0"/><geometry><box size="0.033 0.10 0.016"/></geometry></collision>
  </link>
  <joint name="tool_mount_to_mount_b" type="fixed"><parent link="tool_mount"/><child link="mount_b"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
  <link name="led_tcp"/>
  <joint name="tool_mount_to_led_tcp" type="fixed"><parent link="tool_mount"/><child link="led_tcp"/><origin xyz="0 0 0.04735" rpy="0 0 0"/></joint>
</robot>
