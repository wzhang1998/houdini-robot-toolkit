<?xml version="1.0"?>
<!-- The UV LED bar as built (FULLUVBAR_forWenyi.stp, the fab team, 2026-10-01; assets/tools/cad/), mounted
     on the FR20's flange. Root link: the flange's mounting face (z out of the face). From the CAD (mm, its
     z = 0 the bar's middle, the plate under it): the mounting plate (about 118 dia, 12 thick) on the face,
     the bar (an extrusion 1087.5 long with its end caps, 37 x 35 in section, its clips included) over it,
     its middle 29.75 out; the LEDs (60, 16.67 mm pitch) on its top face, 47.35 out. Boxes contain the parts
     (the plate's disc as its square). The bar's length along the flange's y, as the strip was (check on the
     arm: turn the bar 90 deg about z if it is along x). -->
<robot name="uv_bar">
  <link name="tool_mount"/>
  <link name="bracket">
    <visual>
      <origin xyz="0 0 0.00605" rpy="0 0 0"/>
      <geometry><box size="0.116 0.119 0.0121"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.00605" rpy="0 0 0"/>
      <geometry><box size="0.116 0.119 0.0121"/></geometry>
    </collision>
  </link>
  <joint name="tool_mount_to_bracket" type="fixed">
    <parent link="tool_mount"/>
    <child link="bracket"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="strip">
    <visual>
      <origin xyz="0 0 0.02975" rpy="0 0 0"/>
      <geometry><box size="0.037 1.0875 0.0352"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.02975" rpy="0 0 0"/>
      <geometry><box size="0.037 1.0875 0.0352"/></geometry>
    </collision>
  </link>
  <joint name="tool_mount_to_strip" type="fixed">
    <parent link="tool_mount"/>
    <child link="strip"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="led_tcp"/>
  <joint name="tool_mount_to_led_tcp" type="fixed">
    <parent link="tool_mount"/>
    <child link="led_tcp"/>
    <origin xyz="0 0 0.04735" rpy="0 0 0"/>
  </joint>
</robot>
