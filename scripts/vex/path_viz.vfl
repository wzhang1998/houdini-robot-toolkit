// Colour the achieved path by one metric, auto-normalised over the whole
// path so the ramp always spans the data rather than an arbitrary range.
int n = npoints(0);
int m = chi("viz_metric");

string names[] = {"residual", "orient_error", "vel_max",
                  "flip_ratio", "limit_margin", "tcp_speed"};
string a = names[m];

// limit_margin is inverted: small margin is the dangerous end
int invert = (m == 4) ? 1 : 0;

float mx = 0.0;
float mn = 1e18;
for (int i = 0; i < n; i++) {
    float v = point(0, a, i);
    mx = max(mx, v);
    mn = min(mn, v);
}

float v = point(0, a, @ptnum);
float t = (mx - mn > 1e-12) ? (v - mn) / (mx - mn) : 0.0;
if (invert) t = 1.0 - t;

// blue (fine) -> green -> yellow -> red (worst)
vector c;
if (t < 0.5) {
    c = lerp(set(0.1, 0.3, 1.0), set(0.1, 1.0, 0.3), t * 2.0);
} else {
    c = lerp(set(1.0, 1.0, 0.1), set(1.0, 0.1, 0.1), (t - 0.5) * 2.0);
}
@Cd = c;
@viz_value = v;
@viz_t = t;
