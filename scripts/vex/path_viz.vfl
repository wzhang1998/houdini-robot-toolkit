// Colour the achieved path by one metric.
//
// The ramp used to normalise across raw min..max, which made every metric look
// identical: a single extreme sample flattened everything else into the bottom
// of the range. Measured on a 245-point clip, vel_max ran 2463 at one point
// and 43-60 everywhere else, so 244 points rendered as the same deep blue and
// switching metric only changed which lone point was red.
//
// That extreme sample is NOT an artifact -- point 0 is the last frame (the
// trail emits newest-first) and pre-flight independently flags frame 245 as
// the velocity and residual peak. Discarding it would hide a real problem, so
// the fix is a scale that survives outliers rather than one that removes them.
//
//   Profile Limits : red at a fixed, meaningful value, so a colour means the
//                    same thing on every clip and takes are comparable
//   Percentile     : 5th-95th, for metrics with no absolute reference
//
// Metrics with no profile limit fall back to percentile automatically.

int n = npoints(0);
int m = chi("viz_metric");
int mode = chi("viz_scale");          // 0 = profile limits, 1 = percentile

string names[] = {"residual", "orient_error", "vel_max",
                  "flip_ratio", "limit_margin", "tcp_speed"};
string a = names[m];

// limit_margin is inverted: a small margin is the dangerous end
int invert = (m == 4) ? 1 : 0;

// absolute reference per metric; -1 means "no absolute, use percentile"
float abs_lo = 0.0;
float abs_hi = -1.0;
if (m == 0) abs_hi = chf("viz_res_max");        // metres
if (m == 1) abs_hi = chf("viz_orient_max");     // degrees
if (m == 2) abs_hi = chf("viz_vel_max");        // deg/s, from the profile
if (m == 4) abs_hi = chf("viz_margin_max");     // degrees of headroom

float mn, mx;
int used_abs = 0;

// Banding needs an absolute reference: "over the limit" is meaningless
// against a percentile of this clip's own data.
if ((mode == 0 || mode == 2) && abs_hi > 0.0) {
    mn = abs_lo;
    mx = abs_hi;
    used_abs = 1;
} else {
    // percentile, so one bad sample cannot flatten the rest
    // Indexed assignment, not push(). point() has an inferred return type and
    // push() cannot pick between its float and float[] overloads from it --
    // binding to a local float first does not help either. Writing into a
    // sized array gives the compiler an unambiguous float lvalue.
    float vals[];
    resize(vals, n);
    for (int i = 0; i < n; i++) {
        vals[i] = point(0, a, i);
    }
    vals = sort(vals);
    int lo_i = clamp(int(floor(0.05 * float(n - 1))), 0, n - 1);
    int hi_i = clamp(int(ceil(0.95 * float(n - 1))), 0, n - 1);
    mn = vals[lo_i];
    mx = vals[hi_i];
}

float v = point(0, a, @ptnum);
// Invert BEFORE clamping. t_raw carries how far past the reference a sample
// is, which the banding mode needs: t_raw >= 1 means at or over the limit.
// Clamping first would collapse "just over" and "twenty times over" into 1.0.
float t_raw = (mx - mn > 1e-12) ? (v - mn) / (mx - mn) : 0.0;
if (invert) t_raw = 1.0 - t_raw;
float t = clamp(t_raw, 0.0, 1.0);     // outliers pin to the ends, still visible

f@viz_over = t_raw;                   // >1 means past the reference
i@viz_band = (t_raw >= 1.0) ? 2 : ((t_raw >= chf("viz_warn_frac")) ? 1 : 0);

vector c;
if (mode == 2) {
    // Pass / Warn / Fail. Three flat colours answer "where does this clip
    // break?" at a glance, which a continuous ramp does not -- a ramp shows
    // relative severity but never tells you where the line is.
    if (i@viz_band == 2)      c = set(1.00, 0.12, 0.12);   // over the limit
    else if (i@viz_band == 1) c = set(1.00, 0.72, 0.10);   // approaching it
    else                      c = set(0.15, 0.85, 0.35);   // fine
} else {
    // blue (fine) -> cyan -> green -> yellow -> red (worst). Four stops rather
    // than two: the old version jumped straight from green to yellow at t=0.5.
    if (t < 0.25) {
        c = lerp(set(0.10, 0.30, 1.00), set(0.10, 0.85, 0.95), t * 4.0);
    } else if (t < 0.5) {
        c = lerp(set(0.10, 0.85, 0.95), set(0.15, 0.95, 0.25), (t - 0.25) * 4.0);
    } else if (t < 0.75) {
        c = lerp(set(0.15, 0.95, 0.25), set(1.00, 0.95, 0.10), (t - 0.5) * 4.0);
    } else {
        c = lerp(set(1.00, 0.95, 0.10), set(1.00, 0.10, 0.10), (t - 0.75) * 4.0);
    }
}
@Cd = c;
@viz_value = v;
@viz_t = t;

// legend, read back by the Colour By callback so the ramp has a stated scale
if (@ptnum == 0) {
    setdetailattrib(0, "viz_lo", mn, "set");
    setdetailattrib(0, "viz_hi", mx, "set");
    setdetailattrib(0, "viz_name", a, "set");
    setdetailattrib(0, "viz_absolute", used_abs, "set");
}
