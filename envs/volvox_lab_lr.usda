                point3f[] points = [(-2.7755576e-16, -1.8035632, -1.08), (-1.6653345e-16, 1.8035632, -1.08), (-1.6653345e-16, 1.8035632, 1.08), (-2.7755576e-16, -1.8035632, 1.08)]
                custom bool singleSided = 1
                uniform token subdivisionScheme = "none"
            }
        }
    }

    def Scope "Objects"
    {
        def Cube "base_plate" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
            doc = "the plate the base is bolted to: square to the room, the arm on it turned ~11 deg (user, 2026-09-25); size and centre still estimated. The upper-arm capsule runs ~6 cm fat near it, so no extra margin"
        )
        {
            rel material:binding = </Room/Looks/base_plate>
            custom double motionlab:margin_m = 0
            custom string motionlab:role = "obstacle"
            double size = 1
            double xformOp:rotateZ = -11.28
            double3 xformOp:scale = (1.1, 0.8, 0.02)
            double3 xformOp:translate = (-0.15, -0, -0.01)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ", "xformOp:scale"]
