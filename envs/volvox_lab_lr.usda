            doc = "drawer cart / AC / heater: the TV wall was touched at y -0.19..0.68 below 0.9 m, so kept only at y > 0.8;; RoomPlan Table0 (Project-2609251250.usdz, aligned to the probed Wall2=wall_tv / Wall1=partition_left / floor, yaw 153.03 deg)"
        )
        {
            rel material:binding = </Room/Looks/furniture>
            custom string motionlab:measured = "scan"
            custom string motionlab:role = "obstacle"
            double size = 1
