            doc = "RoomPlan Storage0 (Project-2609251250.usdz, aligned to the probed Wall2=wall_tv / Wall1=partition_left / floor, yaw 153.03 deg)"
        )
        {
            rel material:binding = </Room/Looks/shelves>
            custom string motionlab:measured = "scan"
            custom string motionlab:role = "obstacle"
            double size = 1
            double xformOp:rotateZ = -11.04
            double3 xformOp:scale = (0.9242, 0.3185, 1.8005)
            double3 xformOp:translate = (1.6588, 1.8281, 0.8954)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ", "xformOp:scale"]
        }

        def Cube "control_cart" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
            doc = "red cart: laptop, E-stop; by the door behind the robot (user confirmed on the scan); RoomPlan Storage1"
        )
        {
            rel material:binding = </Room/Looks/cart>
            custom string motionlab:measured = "scan"
            custom string motionlab:role = "obstacle"
            double size = 1
            double xformOp:rotateZ = -101.04
