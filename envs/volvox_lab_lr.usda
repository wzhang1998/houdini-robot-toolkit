#usda 1.0
(
    defaultPrim = "Room"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Room" (
    doc = "FR20 base (URDF): Z up from the base's mounting face; the arm's zero pose points along -X, which is the robot's working front; metres"
)
{
    custom double motionlab:margin_m = 0.05
    custom string motionlab:source = "volvox_lab.usda with the controller's zone widened 356 mm towards the cart (X max 950 mm) for party_lr (its scan left to right, moved 0.3 m that way, in its own scan.stage; the idle clips keep the stage, as the room's; the user, 2026-10-02); everything else as there. MEASURED 2026-09-25 on the real FR20: floor (level), left partition and TV wall (vertical fits) with scripts/probe_ui.py; ceiling grid by tape (2.16 m); tv, furniture_back (side table), control_cart, shelves_right, back and right walls from a RoomPlan scan (Project-2609251250.usdz) aligned to the probed walls with scripts/scan_to_env.py (the two walls agree to 0.47 deg). The room is square and the arm is mounted turned ~11 deg on a plate that is square to it. The plant and the operator's place marked by the user on a screenshot (+-0.2 m). Still ESTIMATED: the plant's size, base_plate size."

    def Scope "Structure"
    {
        def Xform "floor"
        {
            double xformOp:rotateZ = -11.28123413421394
            double3 xformOp:translate = (0.15812585708566682, 0.5525706123592845, -0.0048)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

            def Cube "slab" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
                doc = "level, at the one floor point probed with the flange flat (tilt 2 deg): z -0.0048. The two taken with the flange tilted ~7 deg read 1-2 cm high (the rim touches first) -- a pointed probe tool would remove this. The floor cannot be above the plate the base stands on (z 0)."
            )
            {
                rel material:binding = </Room/Looks/floor>
                custom string motionlab:measured = "true"
                custom string motionlab:role = "obstacle"
                double size = 1
                double3 xformOp:scale = (3.7810473630695958, 3.5721141920016857, 0.05)
                double3 xformOp:translate = (0, 0, -0.025)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }

        def Xform "ceiling"
        {
            double xformOp:rotateZ = -11.28123413421394
            double3 xformOp:translate = (0.15812585708566682, 0.5525706123592845, 2.1552)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

            def Cube "slab" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
                doc = "lowest point of the load-bearing grid under the ceiling: 2.16 m by tape (2026-09-25); the ceiling itself is 2.38 m (RoomPlan scan). The raised arm reaches 2.16 m: this plane is in play"
            )
            {
                custom string motionlab:measured = "tape"
                custom string motionlab:role = "obstacle"
                double size = 1
                token visibility = "invisible"
                double3 xformOp:scale = (3.7810473630695958, 3.5721141920016857, 0.05)
                double3 xformOp:translate = (0, 0, 0.025)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def BasisCurves "outline"
            {
                int[] curveVertexCounts = [5]
                point3f[] points = [(-1.8105236, 1.691178, 0), (-1.8105236, -1.7060571, 0), (1.8105236, -1.6761801, 0), (1.7965721, 1.7060571, 0), (-1.8105236, 1.691178, 0)]
                color3f[] primvars:displayColor = [(0.7, 0.72, 0.75)] (
                    interpolation = "constant"
                )
                uniform token type = "linear"
                float[] widths = [0.015] (
                    interpolation = "constant"
                )
            }
        }

        def Xform "wall_tv"
        {
            double xformOp:rotateZ = -11.28123413421394
            double3 xformOp:translate = (-1.618871665806994, 0.8994584212041561, 1.0751999999999997)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

            def Cube "slab" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
                doc = "carved panel wall with the TV; vertical fit, probed 2026-09-25 (rms 6.4 mm)"
            )
            {
                custom string motionlab:measured = "true"
                custom string motionlab:role = "obstacle"
                double size = 1
                token visibility = "invisible"
                double3 xformOp:scale = (0.08, 3.5572350934360872, 2.26)
                double3 xformOp:translate = (-0.04, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def Mesh "face" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                uniform bool doubleSided = 0
                int[] faceVertexCounts = [4]
                int[] faceVertexIndices = [0, 1, 2, 3]
                rel material:binding = </Room/Looks/wall>
                point3f[] points = [(-1.110223e-16, 1.6986176, 1.08), (-1.110223e-16, -1.6986176, 1.08), (-1.110223e-16, -1.6986176, -1.08), (-1.110223e-16, 1.6986176, -1.08)]
                custom bool singleSided = 1
                uniform token subdivisionScheme = "none"
            }
        }

        def Xform "partition_left"
        {
            double xformOp:rotateZ = 79.1914973836886
            double3 xformOp:translate = (-0.17269915193333563, -1.1058735487640199, 1.0751999999999997)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

            def Cube "slab" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
                doc = "the wall on the robot's left (the 'glass partition' note was a photo guess); vertical fit, probed 2026-09-25 (rms 2.9 mm)"
            )
            {
                custom string motionlab:measured = "true"
                custom string motionlab:role = "obstacle"
                double size = 1
                token visibility = "invisible"
                double3 xformOp:scale = (0.08, 3.7811706168874197, 2.26)
                double3 xformOp:translate = (-0.04, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def Mesh "face" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                uniform bool doubleSided = 0
                int[] faceVertexCounts = [4]
                int[] faceVertexIndices = [0, 1, 2, 3]
                rel material:binding = </Room/Looks/glass_face>
                point3f[] points = [(5.551115e-16, 1.8105853, 1.08), (-5.551115e-16, -1.8105853, 1.08), (-5.551115e-16, -1.8105853, -1.08), (5.551115e-16, 1.8105853, -1.08)]
                custom bool singleSided = 1
                uniform token subdivisionScheme = "none"
            }
        }

        def Xform "wall_back"
        {
            double xformOp:rotateZ = 168.9551068902526
            double3 xformOp:translate = (1.929749351882713, 0.21440146905067103, 1.0751999999999997)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

            def Cube "slab" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
                doc = "RoomPlan Wall0+Wall4 (Project-2609251250.usdz, aligned to the probed Wall2=wall_tv / Wall1=partition_left / floor, yaw 153.03 deg); behind the robot, with the door (Door1) the control cart stands by"
            )
            {
                custom string motionlab:measured = "scan"
                custom string motionlab:role = "obstacle"
                double size = 1
                token visibility = "invisible"
                double3 xformOp:scale = (0.08, 3.5422660354960116, 2.26)
                double3 xformOp:translate = (-0.04, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def Mesh "face" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                uniform bool doubleSided = 0
                int[] faceVertexCounts = [4]
                int[] faceVertexIndices = [0, 1, 2, 3]
                rel material:binding = </Room/Looks/glass_face>
                point3f[] points = [(-1.6653345e-16, 1.691133, 1.08), (3.8857806e-16, -1.691133, 1.08), (3.8857806e-16, -1.691133, -1.08), (-1.6653345e-16, 1.691133, -1.08)]
                custom bool singleSided = 1
                uniform token subdivisionScheme = "none"
            }
        }

        def Xform "wall_right_glass"
        {
            double xformOp:rotateZ = -101.04489310974739
            double3 xformOp:translate = (0.4835768380090544, 2.219733439018847, 1.0751999999999997)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

            def Cube "slab" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
                doc = "RoomPlan Wall3 (Project-2609251250.usdz, aligned to the probed Wall2=wall_tv / Wall1=partition_left / floor, yaw 153.03 deg); a glass wall: RoomPlan read the glass as a 3.55 m opening (Door0), it is solid (user) -- kept as a solid plane"
            )
            {
                custom string motionlab:measured = "scan"
                custom string motionlab:role = "obstacle"
                double size = 1
                token visibility = "invisible"
                double3 xformOp:scale = (0.08, 3.7671264829182944, 2.26)
                double3 xformOp:translate = (-0.04, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def Mesh "face" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                uniform bool doubleSided = 0
                int[] faceVertexCounts = [4]
                int[] faceVertexIndices = [0, 1, 2, 3]
