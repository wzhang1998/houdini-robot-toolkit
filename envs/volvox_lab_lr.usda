                uniform token type = "linear"
                float[] widths = [0.005] (
                    interpolation = "constant"
                )
            }
        }

        def Xform "controller_zone"
        {
            double xformOp:rotateZ = -11.28
            double3 xformOp:translate = (-0.2272, 0.5735, 0.85)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

            def Cube "volume" (
                doc = "the controller's own work area (WebApp interference zone, two-point: X -1620..950, Y -964..2000, Z 100..1600 mm: volvox_lab's X 594 widened 356 mm towards the cart for party_lr's scan, left to right and 0.3 m that way -- the controller must be set so before it runs). Set in the room-aligned workpiece frame (base turned -11.28 deg, same origin) -- confirmed by the user 2026-09-25. The controller stops the arm when the TCP leaves it (auto mode), so clips and moves keep the TCP inside"
            )
            {
                custom string motionlab:role = "work"
                uniform token purpose = "guide"
                double size = 1
                double3 xformOp:scale = (2.5700, 2.964, 1.5)
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def BasisCurves "outline"
            {
                int[] curveVertexCounts = [5, 5, 2, 2, 2, 2]
                point3f[] points = [(-1.285, -1.482, -0.75), (1.285, -1.482, -0.75), (1.285, 1.482, -0.75), (-1.285, 1.482, -0.75), (-1.285, -1.482, -0.75), (-1.285, -1.482, 0.75), (1.285, -1.482, 0.75), (1.285, 1.482, 0.75), (-1.285, 1.482, 0.75), (-1.285, -1.482, 0.75), (-1.285, -1.482, -0.75), (-1.285, -1.482, 0.75), (1.285, -1.482, -0.75), (1.285, -1.482, 0.75), (1.285, 1.482, -0.75), (1.285, 1.482, 0.75), (-1.285, 1.482, -0.75), (-1.285, 1.482, 0.75)]
                color3f[] primvars:displayColor = [(0.2, 0.85, 0.35)] (
                    interpolation = "constant"
                )
                uniform token type = "linear"
                float[] widths = [0.005] (
                    interpolation = "constant"
                )
            }
        }
    }

