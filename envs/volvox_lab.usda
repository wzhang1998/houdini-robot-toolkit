#usda 1.0
(
    defaultPrim = "Room"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Room" (
    doc = "volvox_lab -- FR20 base (URDF): Z up from the base's mounting face; the arm's zero pose points along -X, which is the robot's working front; metres"
)
{
    def Cube "floor" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
        doc = "level, at the one floor point probed with the flange flat (tilt 2 deg): z -0.0048. The two taken with the flange tilted ~7 deg read 1-2 cm high (the rim touches first) -- a pointed probe tool would remove this. The floor cannot be above the plate the base stands on (z 0)."
    )
    {
        rel material:binding = </Room/Looks/obstacle>
        custom float motionlab:margin_m = 0.05
        custom string motionlab:role = "obstacle"
        double size = 1
        quatf xformOp:orient = (0.70710677, 0, -0.70710677, 0)
        float3 xformOp:scale = (0.1, 8, 8)
        double3 xformOp:translate = (-0, -0, -0.0548)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def "Looks"
    {
        def Material "obstacle"
        {
            token outputs:surface.connect = </Room/Looks/obstacle/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.56, 0.58)
                float inputs:opacity = 1
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }

        def Material "keep_out"
        {
            token outputs:surface.connect = </Room/Looks/keep_out/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.2, 0.15)
                float inputs:opacity = 0.15
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }

        def Material "slow"
        {
            token outputs:surface.connect = </Room/Looks/slow/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 0.65, 0.1)
                float inputs:opacity = 0.15
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }

        def Material "work"
        {
            token outputs:surface.connect = </Room/Looks/work/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.2, 0.85, 0.35)
                float inputs:opacity = 0.15
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }
    }

    def Cube "base_plate" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
        doc = "the plate the base is bolted to: square to the room, the arm on it turned ~11 deg (user, 2026-09-25); size and centre still estimated. The upper-arm capsule runs ~6 cm fat near it, so no extra margin"
    )
    {
        rel material:binding = </Room/Looks/obstacle>
        custom float motionlab:margin_m = 0
        custom string motionlab:role = "obstacle"
        double size = 1
        quatf xformOp:orient = (0.99515903, -0, -0, -0.09827767)
        float3 xformOp:scale = (1.1, 0.8, 0.02)
        double3 xformOp:translate = (-0.15, -0, -0.01)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Cube "ceiling" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
        doc = "lowest point of the load-bearing grid under the ceiling: 2.16 m by tape (2026-09-25); the ceiling itself is 2.38 m (RoomPlan scan). The raised arm reaches 2.16 m: this plane is in play"
    )
    {
        rel material:binding = </Room/Looks/obstacle>
        custom float motionlab:margin_m = 0.05
        custom string motionlab:role = "obstacle"
        double size = 1
        quatf xformOp:orient = (0.70710677, 0, 0.70710677, 0)
        float3 xformOp:scale = (0.1, 8, 8)
        double3 xformOp:translate = (0, 0, 2.2051999999999996)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Cube "wall_tv" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
        doc = "carved panel wall with the TV; vertical fit, probed 2026-09-25 (rms 6.4 mm)"
    )
    {
        rel material:binding = </Room/Looks/obstacle>
        custom float motionlab:margin_m = 0.05
        custom string motionlab:role = "obstacle"
        double size = 1
        quatf xformOp:orient = (0.99515796, 0, 0, -0.098288395)
        float3 xformOp:scale = (0.1, 8, 8)
        double3 xformOp:translate = (-1.7785100076963427, 0.3547756404038396, -0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Cube "tv" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
        doc = "on the TV wall;; RoomPlan Television0 (Project-2609251250.usdz, aligned to the probed Wall2=wall_tv / Wall1=partition_left / floor, yaw 153.03 deg)"
    )
    {
        rel material:binding = </Room/Looks/obstacle>
        custom float motionlab:margin_m = 0.05
        custom string motionlab:role = "obstacle"
        double size = 1
        quatf xformOp:orient = (0.7718466, 0, 0, 0.6358088)
        float3 xformOp:scale = (1.6797, 0.0994, 0.8982)
        double3 xformOp:translate = (-1.5778, 0.863, 1.463)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Cube "furniture_back" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
        doc = "drawer cart / AC / heater: the TV wall was touched at y -0.19..0.68 below 0.9 m, so kept only at y > 0.8;; RoomPlan Table0 (Project-2609251250.usdz, aligned to the probed Wall2=wall_tv / Wall1=partition_left / floor, yaw 153.03 deg)"
    )
    {
        rel material:binding = </Room/Looks/obstacle>
        custom float motionlab:margin_m = 0.05
        custom string motionlab:role = "obstacle"
        double size = 1
        quatf xformOp:orient = (0.7718466, 0, 0, 0.6358088)
        float3 xformOp:scale = (0.5874, 0.5282, 0.5015)
        double3 xformOp:translate = (-1.2299, 1.5259, 0.246)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Cube "partition_left" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
        doc = "the wall on the robot's left (the 'glass partition' note was a photo guess); vertical fit, probed 2026-09-25 (rms 2.9 mm)"
    )
    {
        rel material:binding = </Room/Looks/obstacle>
        custom float motionlab:margin_m = 0.05
        custom string motionlab:role = "obstacle"
        double size = 1
        quatf xformOp:orient = (0.77056056, 0, 0, 0.63736683)
        float3 xformOp:scale = (0.1, 8, 8)
        double3 xformOp:translate = (-0.21915164983714244, -1.1479076635224885, -0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Cube "shelves_right" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
        doc = "RoomPlan Storage0 (Project-2609251250.usdz, aligned to the probed Wall2=wall_tv / Wall1=partition_left / floor, yaw 153.03 deg)"
    )
    {
        rel material:binding = </Room/Looks/obstacle>
        custom float motionlab:margin_m = 0.05
        custom string motionlab:role = "obstacle"
        double size = 1
        quatf xformOp:orient = (0.9953627, -0, -0, -0.0961932)
        float3 xformOp:scale = (0.9242, 0.3185, 1.8005)
        double3 xformOp:translate = (1.6588, 1.8281, 0.8954)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Cube "control_cart" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
        doc = "red cart: laptop, E-stop; by the door behind the robot (user confirmed on the scan); RoomPlan Storage1"
    )
    {
        rel material:binding = </Room/Looks/obstacle>
        custom float motionlab:margin_m = 0.05
        custom string motionlab:role = "obstacle"
        double size = 1
        quatf xformOp:orient = (0.6358088, -0, -0, -0.7718466)
        float3 xformOp:scale = (0.6937, 0.6337, 1.0909)
        double3 xformOp:translate = (1.5562, -0.0452, 0.5407)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Cylinder "operator" (
        prepend apiSchemas = ["MaterialBindingAPI"]
        doc = "where the operator stands, hand on the E-stop: behind the robot beside the control cart, door side (user, 2026-09-25; +-0.2 m). Keep-out: no link may enter"
    )
    {
        uniform token axis = "Z"
        double height = 2
        rel material:binding = </Room/Looks/keep_out>
        custom float motionlab:margin_m = 0.05
        custom string motionlab:role = "keep_out"
        double radius = 0.4
        double3 xformOp:translate = (1.453, -0.661, 1)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "operator_slow" (
        prepend apiSchemas = ["MaterialBindingAPI"]
        doc = "ISO/TS 15066-style reduced speed round the operator: inside it the TCP may not exceed 0.25 m/s"
    )
    {
        uniform token axis = "Z"
        double height = 2.4
        rel material:binding = </Room/Looks/slow>
        custom float motionlab:margin_m = 0.05
        custom string motionlab:role = "slow"
        double radius = 1.3
        double3 xformOp:translate = (1.453, -0.661, 1.2)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "stage" (
        prepend apiSchemas = ["MaterialBindingAPI"]
        doc = "where the TCP performs: room-aligned, 0.15 m inside the TV wall, the left partition and the right glass wall, 0.6 m behind the base (the operator and cart side stays out), 0.15 m under the ceiling"
    )
    {
        rel material:binding = </Room/Looks/work>
        custom float motionlab:margin_m = 0.05
        custom string motionlab:role = "work"
        double size = 1
        quatf xformOp:orient = (0.99515903, -0, -0, -0.09827767)
        float3 xformOp:scale = (2.2136, 3.0857, 2.0052)
        double3 xformOp:translate = (-0.3898, 0.6676, 1.0026)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Cube "wall_back" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
        doc = "RoomPlan Wall0+Wall4 (Project-2609251250.usdz, aligned to the probed Wall2=wall_tv / Wall1=partition_left / floor, yaw 153.03 deg); behind the robot, with the door (Door1) the control cart stands by"
    )
    {
        rel material:binding = </Room/Looks/obstacle>
        custom float motionlab:margin_m = 0.05
        custom string motionlab:role = "obstacle"
        double size = 1
        quatf xformOp:orient = (0.09623571, 0, -0, 0.9953586)
        float3 xformOp:scale = (0.1, 8, 8)
        double3 xformOp:translate = (1.8676827451617084, -0.36455966360147996, -0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Cube "wall_right_glass" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
        doc = "RoomPlan Wall3 (Project-2609251250.usdz, aligned to the probed Wall2=wall_tv / Wall1=partition_left / floor, yaw 153.03 deg); a glass wall: RoomPlan read the glass as a 3.55 m opening (Door0), it is solid (user) -- kept as a solid plane"
    )
    {
        rel material:binding = </Room/Looks/obstacle>
        custom float motionlab:margin_m = 0.05
        custom string motionlab:role = "obstacle"
        double size = 1
        quatf xformOp:orient = (0.63577586, 0, -0, -0.7718737)
        float3 xformOp:scale = (0.1, 8, 8)
        double3 xformOp:translate = (0.44470251913184994, 2.2782641763144555, -0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Cylinder "plant" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
        doc = "the one plant: front-right corner (TV wall / glass wall); position read off a Houdini screenshot the user marked, 2026-09-25 (+-0.2 m); radius and height estimated"
    )
    {
        uniform token axis = "Z"
        double height = 1.9
        rel material:binding = </Room/Looks/obstacle>
        custom float motionlab:margin_m = 0.05
        custom string motionlab:role = "obstacle"
        double radius = 0.3
        double3 xformOp:translate = (-1.074, 2.099, 0.95)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "controller_zone" (
        prepend apiSchemas = ["MaterialBindingAPI"]
        doc = "the controller's own work area (WebApp interference zone, two-point: X -1620..594, Y -964..2000, Z 100..1600 mm, 2026-09-25). Set in the room-aligned workpiece frame (base turned -11.28 deg, same origin) -- confirmed by the user 2026-09-25. The controller stops the arm when the TCP leaves it (auto mode), so clips and moves keep the TCP inside"
    )
    {
        rel material:binding = </Room/Looks/work>
        custom float motionlab:margin_m = 0.05
        custom string motionlab:role = "work"
        double size = 1
        quatf xformOp:orient = (0.99515903, -0, -0, -0.09827767)
        float3 xformOp:scale = (2.214, 2.964, 1.5)
        double3 xformOp:translate = (-0.4018, 0.6083, 0.85)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Cube "canvas" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
        doc = "the show's paper (placeholder)"
    )
    {
        rel material:binding = </Room/Looks/obstacle>
        custom float motionlab:margin_m = 0.05
        custom string motionlab:role = "obstacle"
        double size = 1
        quatf xformOp:orient = (0.7723463, 0, 0, 0.6352017)
        float3 xformOp:scale = (0.02, 1, 0.6)
        double3 xformOp:translate = (0.07, 1.41, 0.88)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }
}

