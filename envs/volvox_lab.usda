#usda 1.0
(
    defaultPrim = "Room"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Room" (
    doc = "volvox_lab -- FR20 base (URDF): Z up from the base's mounting face; the arm's zero pose points along -X, which is the robot's working front; metres"
)
{
    def Scope "Structure"
    {
        def Mesh "floor" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
            doc = "level, at the one floor point probed with the flange flat (tilt 2 deg): z -0.0048. The two taken with the flange tilted ~7 deg read 1-2 cm high (the rim touches first) -- a pointed probe tool would remove this. The floor cannot be above the plate the base stands on (z 0)."
        )
        {
            int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [3, 2, 1, 0, 4, 5, 6, 7, 0, 1, 5, 4, 1, 2, 6, 5, 2, 3, 7, 6, 3, 0, 4, 7]
            rel material:binding = </Room/Looks/floor>
            custom float motionlab:margin_m = 0.05
            custom string motionlab:role = "obstacle"
            point3f[] points = [(-1.2865797, 2.5652566, -0.0548), (-1.9511636, -0.7663398, -0.0548), (1.6057653, -1.4454073, -0.0548), (2.2537334, 1.8742102, -0.0548), (-1.2865797, 2.5652566, -0.0048), (-1.9511636, -0.7663398, -0.0048), (1.6057653, -1.4454073, -0.0048), (2.2537334, 1.8742102, -0.0048)]
            uniform token subdivisionScheme = "none"
        }

